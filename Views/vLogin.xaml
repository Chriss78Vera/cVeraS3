<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="cVeraS3.Views.vLogin"
    Title="Inicio de sesión">

    <ScrollView>
        <VerticalStackLayout Padding="24,36" Spacing="18">
            <Image Source="logo.png" HeightRequest="120" Aspect="AspectFit" />
            <Label Text="Portal académico" Style="{StaticResource TituloPagina}" />
            <Label Text="Ingresa tus datos para continuar" Style="{StaticResource TextoSecundario}" />

            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="22" Margin="0,12,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="#25000000" Offset="0,6" Radius="18" Opacity="0.35" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Usuario" Style="{StaticResource EtiquetaFormulario}" />
                    <Entry x:Name="txtUsuario" Placeholder="Ingresa tu usuario" ClearButtonVisibility="WhileEditing" />
                    <Label Text="Contraseña" Style="{StaticResource EtiquetaFormulario}" Margin="0,10,0,0" />
                    <Entry x:Name="txtClave" Placeholder="Ingresa tu contraseña" IsPassword="True" />
                    <Button x:Name="btnIniciarSesion" Style="{StaticResource GlobalBotones}" Text="Iniciar sesión" Clicked="btnIniciarSesion_Clicked" Margin="0,14,0,0" />
                    <Button x:Name="btnRegistrar" Style="{StaticResource BotonSecundario}" Text="Crear una cuenta" Clicked="btnRegistrar_Clicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
