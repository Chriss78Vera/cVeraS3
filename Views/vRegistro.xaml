<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="cVeraS3.Views.vRegistro"
             Title="Registro de usuario">

    <ScrollView>
        <VerticalStackLayout Padding="24,42" Spacing="16">
            <Label Text="Crear una cuenta" Style="{StaticResource TituloPagina}" />
            <Label Text="Completa tus datos para registrarte" Style="{StaticResource TextoSecundario}" />
            <Border BackgroundColor="White" Stroke="#E5E7EB" StrokeThickness="1" Padding="22" Margin="0,14,0,0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="22" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="8">
                    <Label Text="Usuario" Style="{StaticResource EtiquetaFormulario}" />
                    <Entry x:Name="txtUsuarioNuevo" Style="{StaticResource CampoFormulario}" Placeholder="Elige un usuario" />
                    <Label Text="Contraseña" Style="{StaticResource EtiquetaFormulario}" Margin="0,10,0,0" />
                    <Entry x:Name="txtClave" Style="{StaticResource CampoFormulario}" Placeholder="Crea una contraseña" IsPassword="True" />
                    <Button x:Name="btnGuardar" Style="{StaticResource GlobalBotones}" Text="Guardar usuario" Clicked="btnGuardar_Clicked" Margin="0,14,0,0" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
